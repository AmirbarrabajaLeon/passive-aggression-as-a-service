# ==========================================
# WhatsApp Sticker Bot Configuration
# ==========================================

# Target WhatsApp Group JID (e.g. 120363012345678901@g.us)
# Tip: Run `pnpm groups` or `pnpm groups <SearchName>` to find your group ID and member IDs instantly!
TARGET_GROUP_JID=

# Target friend's identifier. Accepts ANY of the following:
# 1. Phone number: Digits only with country code (e.g. 15551234567)
# 2. Privacy LID: From `pnpm groups` (e.g. 247390000000000)
# 3. WhatsApp Username: (e.g. Alex_99 or @Alex_99)
TARGET_SENDER_PHONE=

# Reply Mode: "debounce" | "queue" | "cooldown"
# - debounce: Waits until he finishes talking, then quotes his latest message.
# - queue: Replies to each message sequentially with random pauses.
# - cooldown: Replies to his first message and ignores him for COOLDOWN_MS.
REPLY_MODE=debounce

# Time to wait after his last message before triggering the sticker (in ms)
DEBOUNCE_WAIT_MS=3500

# Cooldown duration in milliseconds (used in "cooldown" mode)
COOLDOWN_MS=30000

# Random human jitter range added to delays (in ms)
JITTER_MIN_MS=1500
JITTER_MAX_MS=3500

# Send simulated typing presence indicator before replying
SIMULATE_TYPING=true

# Sticker pool directory relative to project root
STICKERS_DIR=./stickers

# Legacy/override single sticker file relative to project root (optional)
STICKER_PATH=./stickers/lion.webp

# Discovery Mode: prints incoming group IDs and sender numbers to terminal
DISCOVERY_MODE=true

# Self-Test Mode: Set to true to test the bot using your own messages (e.g. in Note to Self or test group)
ALLOW_SELF_TEST=true

# (Recommended for iPhone): Put your own phone number here to link via Pairing Code instead of QR.
# Digits only with country code (e.g. 15551234567). Leave blank if you prefer scanning QR code.
MY_PHONE_NUMBER=

